{
  "name": "strawn-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["website", "packages/*"],
  "scripts": {
    "build": "bun run font:build && bun run website:build",
    "font:build": "bun run --cwd packages/font build",
    "font:test": "bun run --cwd packages/font test",
    "font:test:determinism": "bun run --cwd packages/font test:determinism",
    "font:test:fontbakery": "bun run --cwd packages/font test:fontbakery",
    "font:quality": "bun run --cwd packages/font quality",
    "website:dev": "bun run --cwd website dev",
    "website:build": "bun run --cwd website build",
    "website:preview": "bun run --cwd website preview",
    "lint": "biome lint website quality-tests",
    "typecheck": "bun run --cwd website typecheck",
    "test:unit": "vitest run",
    "test:browser": "bun run website:build && playwright test",
    "test:browser:functional": "bun run website:build && playwright test --project=functional",
    "test:browser:visual": "bun run website:build && playwright test --project=visual",
    "quality:motion": "node quality-tests/check-motion-policy.mjs",
    "quality:bundle": "node quality-tests/check-bundle-budget.mjs",
    "quality:lighthouse": "node quality-tests/run-lighthouse.mjs",
    "quality": "bun run font:quality && bun run lint && bun run typecheck && bun run test:unit && bun run website:build && bun run quality:motion && bun run quality:bundle"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
