{
  "name": "@moriatz-labs/strawn",
  "version": "0.7.0",
  "description": "Strawn — Moriatz Labs' tapered variable system typeface.",
  "license": "OFL-1.1",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "OFL.txt"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./variable.css": "./dist/index.css",
    "./files/*": "./dist/files/*"
  },
  "scripts": {
    "build": "uv run --python 3.12 --with-requirements requirements.txt python scripts/build.py",
    "test": "uv run --python 3.12 --with-requirements requirements.txt python scripts/test_font.py",
    "test:determinism": "uv run --python 3.12 --with-requirements requirements.txt python scripts/test_determinism.py",
    "test:fontbakery": "uv run --python 3.12 --with-requirements requirements-quality.txt python scripts/test_fontbakery.py",
    "quality": "uv run --python 3.12 --with-requirements requirements-quality.txt python scripts/build.py && uv run --python 3.12 --with-requirements requirements-quality.txt python scripts/test_font.py && uv run --python 3.12 --with-requirements requirements-quality.txt python scripts/test_determinism.py && uv run --python 3.12 --with-requirements requirements-quality.txt python scripts/test_fontbakery.py"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paul-M-Kallarackal/strawn.git",
    "directory": "packages/font"
  },
  "homepage": "https://strawn.moriatz.com",
  "bugs": "https://github.com/Paul-M-Kallarackal/strawn/issues",
  "keywords": [
    "font",
    "variable-font",
    "system-font",
    "moriatz"
  ]
}
