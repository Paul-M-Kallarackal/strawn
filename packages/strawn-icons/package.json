{
  "name": "strawn-icons",
  "version": "0.1.0",
  "description": "The icon library for Strawn — Moriatz’s official design system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=18.2 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "lucide-static": "0.564.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moriatz-labs/strawn.git",
    "directory": "packages/strawn-icons"
  },
  "homepage": "https://design.moriatz.com/icons",
  "bugs": "https://github.com/moriatz-labs/strawn/issues"
}
